import PredictionDepth.FrozenPascal.GuardRules
import PredictionDepth.FrozenPascal.UniformReducers
import PredictionDepth.FrozenPascal.UniformRegisters
import PredictionDepth.LogBounds

/-! Native code generation for arbitrary fixed Boolean guards on raw controls. -/

namespace PredictionDepth.FrozenPascal.UniformGuards
open Cslib Cslib.Circuits Cslib.Circuits.Boolean
open Turing.MultiTapeTM
open StandardComplexity

theorem rawWidth_logspace (q : ℕ) :
    ComputableInLogSpace (RawWidth q) encUnary encUnary :=
  (ComputableInLogSpace.id.unaryMulConst q).unaryAdd ComputableInLogSpace.id

theorem controlWiring_code {q m : ℕ} (i : Fin m) :
    (Circuit.wiring signature (controlWire (q := q) i)).code =
      ([], (List.range q).map (fun j => i.val * q + j)) :=
  Circuit.code_wiring_eq_map (fun _ => by
    simp [controlWire, finProdFinEquiv, Nat.mul_comm, Nat.add_comm])

/-- The raw worker is defined also at invalid indices, then masked by the
typed indexed-bank constructor. No input-dependent computation is hardwired. -/
theorem guardBank_logspace {q : ℕ} (c : Gates q 1) :
    ComputableInLogSpace (fun m => (guardBank c m).code) encUnary encCode := by
  have hp := ComputableInLogSpace.fst encUnary encUnary
  have hi := ComputableInLogSpace.snd encUnary encUnary
  have hpp := ComputableInLogSpace.fst (encPair encUnary encUnary) encUnary
  have hj := ComputableInLogSpace.snd (encPair encUnary encUnary) encUnary
  have haddr := (((hi.comp hpp).unaryMulConst q).unaryAdd hj).unaryToBinary
  have hwires := CodeLogspace.map_range (ComputableInLogSpace.const q) haddr
  have hw : ComputableInLogSpace
      (fun p : ℕ × ℕ => (([], (List.range q).map (fun j => p.2 * q + j)) : CodeLogspace.RawCode))
      (encPair encUnary encUnary) encCode := (ComputableInLogSpace.const []).pair hwires
  have hlocal := CodeLogspace.compCode_logspace ((rawWidth_logspace q).comp hp)
    (ComputableInLogSpace.const c.code) hw (fun p => by
      simp only [List.length_map, List.length_range]
      rw [Circuit.length_code_fst c]
      exact CodeLogspace.circuit_boundedReferences c)
  apply CodeLogspaceFamilies.circuit_pi_of_indexed_logspace (rawWidth_logspace q)
    ComputableInLogSpace.id
  have h := (hi.unaryLt hp).ite hlocal (ComputableInLogSpace.const ([], []))
  refine h.congr_fun ?_
  intro p
  simp only [decide_eq_true_eq]
  split_ifs with hp
  · rw [← compCode_code, controlWiring_code]
    rfl
  · rfl

theorem dataWiring_logspace (q : ℕ) :
    ComputableInLogSpace
      (fun m => (Circuit.wiring signature (rawDataWire (q := q) (m := m))).code)
      encUnary encCode := by
  apply Code.wiring ComputableInLogSpace.id
    (((ComputableInLogSpace.fst encUnary encUnary).unaryMulConst q).unaryAdd
      (ComputableInLogSpace.snd encUnary encUnary)).unaryToBinary
  intro m i
  rfl

/-- Evaluate both fixed guard circuits independently at every cell, then append
the data wires; the full code is generated by a native logspace transducer. -/
theorem preprocess_logspace {q : ℕ} (stay hop : Gates q 1) :
    ComputableInLogSpace (fun m => (preprocess stay hop m).code) encUnary encCode :=
  CodeLogspace.circuit_append_logspace (rawWidth_logspace q) (guardBank_logspace stay)
    (CodeLogspace.circuit_append_logspace (rawWidth_logspace q) (guardBank_logspace hop)
      (dataWiring_logspace q))

theorem rawWidth_succ_logspace (q : ℕ) :
    ComputableInLogSpace (fun T => RawWidth q (T + 1)) encUnary encUnary :=
  (rawWidth_logspace q).comp UniformRegisters.succ_logspace

theorem preprocess_succ_logspace {q : ℕ} (stay hop : Gates q 1) :
    ComputableInLogSpace (fun T => (preprocess stay hop (T + 1)).code) encUnary encCode :=
  (preprocess_logspace stay hop).comp UniformRegisters.succ_logspace

/-! ### Lifting a time-indexed predictor to the standard length-indexed model -/

def ValidLength (q n : ℕ) : Prop := 0 < n ∧ n % (q + 1) = 0

instance (q n : ℕ) : Decidable (ValidLength q n) := inferInstanceAs (Decidable (_ ∧ _))

def timeOfLength (q n : ℕ) : ℕ := n / (q + 1) - 1

theorem rawWidth_eq (q m : ℕ) : RawWidth q m = (q + 1) * m := by
  dsimp only [RawWidth]
  ring

theorem quotient_pos_of_valid {q n : ℕ} (h : ValidLength q n) : 0 < n / (q + 1) := by
  have he := Nat.mod_add_div n (q + 1)
  rw [h.2, Nat.zero_add] at he
  by_contra hn
  have hz : n / (q + 1) = 0 := Nat.eq_zero_of_not_pos hn
  rw [hz, Nat.mul_zero] at he
  have := h.1
  omega

theorem rawWidth_timeOfLength {q n : ℕ} (h : ValidLength q n) :
    RawWidth q (timeOfLength q n + 1) = n := by
  have hq := quotient_pos_of_valid h
  rw [rawWidth_eq, timeOfLength, Nat.sub_add_cancel (by omega : 1 ≤ n / (q + 1))]
  have he := Nat.mod_add_div n (q + 1)
  simpa only [h.2, Nat.zero_add] using he

theorem validLength_rawWidth (q T : ℕ) : ValidLength q (RawWidth q (T + 1)) := by
  rw [rawWidth_eq]
  exact ⟨Nat.mul_pos (Nat.succ_pos _) (Nat.succ_pos _), Nat.mul_mod_right _ _⟩

theorem timeOfLength_rawWidth (q T : ℕ) : timeOfLength q (RawWidth q (T + 1)) = T := by
  rw [timeOfLength, rawWidth_eq, Nat.mul_div_cancel_left _ (Nat.succ_pos q)]
  omega

def castInputs {n m k : ℕ} (h : n = m) (c : Gates n k) : Gates m k :=
  cast (congrArg (fun a => Gates a k) h) c

@[simp] theorem castInputs_code {n m k : ℕ} (h : n = m) (c : Gates n k) :
    (castInputs h c).code = c.code := by subst m; rfl

@[simp] theorem castInputs_depth {n m k : ℕ} (h : n = m) (c : Gates n k) :
    (castInputs h c).depth = c.depth := by subst m; rfl

/-- A total standard circuit family: valid lengths select exactly one time,
and all remaining lengths are rejected by a constant-false circuit. -/
def lift {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1) : BooleanCircuitFamily := fun n =>
  if h : ValidLength q n then castInputs (rawWidth_timeOfLength h) (P (timeOfLength q n))
  else constBit n false

theorem lift_code {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1) (n : ℕ) :
    (lift P n).code =
      if ValidLength q n then (P (timeOfLength q n)).code else (constBit n false).code := by
  unfold lift
  split_ifs <;> simp only [castInputs_code]

theorem lift_at_time {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1) (T : ℕ) :
    lift P (RawWidth q (T + 1)) = P T := by
  apply Circuit.code_injective
  rw [lift_code, ite_eq_left (validLength_rawWidth q T), timeOfLength_rawWidth]

theorem lift_invalid_eval {q n : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1)
    (h : ¬ ValidLength q n) (x : Fin n → Bool) :
    (lift P n).eval interpretation x 0 = false := by
  simp [lift, h]

theorem timeOfLength_logspace (q : ℕ) :
    ComputableInLogSpace (timeOfLength q) encUnary encUnary :=
  (ComputableInLogSpace.id.unaryDiv (ComputableInLogSpace.const (q + 1))).unarySub
    (ComputableInLogSpace.const 1)

theorem validLength_logspace (q : ℕ) :
    ComputableInLogSpace (fun n => decide (ValidLength q n)) encUnary encBool := by
  have hid : ComputableInLogSpace (fun n : ℕ => n) encUnary encUnary := ComputableInLogSpace.id
  have hp := (ComputableInLogSpace.const 0).unaryLt hid
  have hm := (hid.unaryMod (ComputableInLogSpace.const (q + 1))).unaryEq
    (ComputableInLogSpace.const 0)
  exact (hp.bool_and hm).congr_fun (fun n => by
    by_cases h₁ : 0 < n <;> by_cases h₂ : n % (q + 1) = 0 <;> simp [ValidLength, h₁, h₂])

theorem lift_code_logspace {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1)
    (hP : ComputableInLogSpace (fun T => (P T).code) encUnary encCode) :
    ComputableInLogSpace (fun n => (lift P n).code) encUnary encCode := by
  have h := (validLength_logspace q).ite (hP.comp (timeOfLength_logspace q))
    (Code.constant ComputableInLogSpace.id false)
  exact h.congr_fun (fun n => by simp only [lift_code, decide_eq_true_eq, Function.comp_apply])

theorem lift_uniform {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1)
    (hP : ComputableInLogSpace (fun T => (P T).code) encUnary encCode) :
    LogspaceUniform (lift P) :=
  (ComputableInLogSpace.id.pair (lift_code_logspace P hP)).congr (fun _ => rfl)

/-- Logarithmic time-indexed depth remains logarithmic in the full raw input
length, including the rejected length-zero and malformed-length cases. -/
theorem lift_depth_log_bound {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1) (C K : ℕ)
    (hP : ∀ T, (P T).depth ≤ C + K * Nat.clog 2 (T + 2)) :
    ∀ n, (lift P n).depth ≤ (C + K + 1) * (Nat.log 2 n + 1) := by
  intro n
  have hbase : 1 ≤ Nat.log 2 n + 1 := by omega
  unfold lift
  split_ifs with hn
  · rw [castInputs_depth]
    have hquot := quotient_pos_of_valid hn
    have hself := Nat.div_le_self n (q + 1)
    have htime : timeOfLength q n + 2 ≤ n + 1 := by unfold timeOfLength; omega
    have hlog := (Nat.clog_mono_right 2 htime).trans (clog_succ_le_log_add_one n)
    have hmul := Nat.mul_le_mul_left K hlog
    have hC := Nat.mul_le_mul_left C hbase
    have h := hP (timeOfLength q n)
    nlinarith
  · simp only [constBit_depth]
    exact Nat.mul_le_mul (by omega : 1 ≤ C + K + 1) hbase

def liftLanguage {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1) : Set (List Bool) :=
  {x | evaluateFamily (lift P) x = true}

theorem lift_mem_uniformNC_one {q : ℕ} (P : ∀ T, Gates (RawWidth q (T + 1)) 1)
    (hP : ComputableInLogSpace (fun T => (P T).code) encUnary encCode) (C K : ℕ)
    (hdepth : ∀ T, (P T).depth ≤ C + K * Nat.clog 2 (T + 2)) :
    liftLanguage P ∈ UniformNCLevel 1 :=
  mem_uniformNCLevel_of_uniform (lift_uniform P hP) (fun _ => Iff.rfl)
    (fun n => by simpa only [pow_one] using lift_depth_log_bound P C K hdepth n)

end PredictionDepth.FrozenPascal.UniformGuards
